    "metadata": {
      "title": "ISO/IEC 42001:2023 Annex A \u2014 community control summaries",
      "version": "2023",
      "oscal-version": "1.1.2",
      "last-modified": "2026-11-28T00:00:00Z",
      "links": [
        {
          "href": "https://www.iso.org/standard/42001",
          "rel": "reference"
        },
        {
          "href": "https://www.services.bis.gov.in/tmp/LITD38624566_23072024_2.pdf",
          "rel": "reference"
        }
      ],
      "remarks": "38 control identifiers checked against Annex A Table A.1 in the Bureau of Indian Standards adoption of ISO/IEC 42001:2023. Titles and statements are original summaries. Refer to the standard for normative wording. Each control requires review of organizational documentation or implementation evidence. Fixture outcomes may contribute evidence after review."
    },
    "groups": [
      {
        "id": "a2",
        "title": "A.2 \u2014 AI policy",
        "controls": [
          {
            "id": "iso-42001-a.2.2",
            "title": "A.2.2 \u2014 Policy for AI",
            "parts": [
              {
                "id": "iso-42001-a.2.2-statement",
                "name": "statement",
                "prose": "Maintain a documented policy covering how the organization develops or uses AI."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.2.3",
            "title": "A.2.3 \u2014 Alignment with organizational policies",
            "parts": [
              {
                "id": "iso-42001-a.2.3-statement",
                "name": "statement",
                "prose": "Identify where existing policies relate to the organization's AI objectives or could be affected by them."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.2.4",
            "title": "A.2.4 \u2014 AI policy review",
            "parts": [
              {
                "id": "iso-42001-a.2.4-statement",
                "name": "statement",
                "prose": "Review the AI policy on a schedule and when needed to keep it effective and appropriate."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a3",
        "title": "A.3 \u2014 Internal governance",
        "controls": [
          {
            "id": "iso-42001-a.3.2",
            "title": "A.3.2 \u2014 AI roles and accountability",
            "parts": [
              {
                "id": "iso-42001-a.3.2-statement",
                "name": "statement",
                "prose": "Define AI responsibilities and assign them in a way that meets the organization's needs."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.3.3",
            "title": "A.3.3 \u2014 Channels for raising concerns",
            "parts": [
              {
                "id": "iso-42001-a.3.3-statement",
                "name": "statement",
                "prose": "Provide a way to report concerns about the organization's involvement with an AI system over its life cycle."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a4",
        "title": "A.4 \u2014 AI system resources",
        "controls": [
          {
            "id": "iso-42001-a.4.2",
            "title": "A.4.2 \u2014 Documenting resources",
            "parts": [
              {
                "id": "iso-42001-a.4.2-statement",
                "name": "statement",
                "prose": "Identify and record the resources needed at relevant life-cycle stages and for other applicable AI activities."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.4.3",
            "title": "A.4.3 \u2014 Data resources",
            "parts": [
              {
                "id": "iso-42001-a.4.3-statement",
                "name": "statement",
                "prose": "Record information about the data resources used by the system."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.4.4",
            "title": "A.4.4 \u2014 Tools used by the system",
            "parts": [
              {
                "id": "iso-42001-a.4.4-statement",
                "name": "statement",
                "prose": "Record information about the tools used by the AI system."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.4.5",
            "title": "A.4.5 \u2014 Computing and system resources",
            "parts": [
              {
                "id": "iso-42001-a.4.5-statement",
                "name": "statement",
                "prose": "Record the system and computing resources used by the AI system."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.4.6",
            "title": "A.4.6 \u2014 Personnel and skills",
            "parts": [
              {
                "id": "iso-42001-a.4.6-statement",
                "name": "statement",
                "prose": "Document the people and skills used across activities such as development, operation, verification and retirement."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a5",
        "title": "A.5 \u2014 AI impact assessment",
        "controls": [
          {
            "id": "iso-42001-a.5.2",
            "title": "A.5.2 \u2014 Process for assessing impacts",
            "parts": [
              {
                "id": "iso-42001-a.5.2-statement",
                "name": "statement",
                "prose": "Establish a process to assess consequences for individuals, groups and society across the AI system life cycle."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.5.3",
            "title": "A.5.3 \u2014 Records of impact assessments",
            "parts": [
              {
                "id": "iso-42001-a.5.3-statement",
                "name": "statement",
                "prose": "Document impact assessment results and retain them for a defined period."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.5.4",
            "title": "A.5.4 \u2014 Impacts on people and groups",
            "parts": [
              {
                "id": "iso-42001-a.5.4-statement",
                "name": "statement",
                "prose": "Assess and record possible effects on individuals or groups across the system life cycle."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.5.5",
            "title": "A.5.5 \u2014 Societal impacts",
            "parts": [
              {
                "id": "iso-42001-a.5.5-statement",
                "name": "statement",
                "prose": "Assess and record possible societal effects across the system life cycle."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a6",
        "title": "A.6 \u2014 AI system life cycle",
        "controls": [
          {
            "id": "iso-42001-a.6.1.2",
            "title": "A.6.1.2 \u2014 Responsible development objectives",
            "parts": [
              {
                "id": "iso-42001-a.6.1.2-statement",
                "name": "statement",
                "prose": "Document objectives for responsible AI development and integrate measures to achieve them throughout development."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.1.3",
            "title": "A.6.1.3 \u2014 Responsible design and development processes",
            "parts": [
              {
                "id": "iso-42001-a.6.1.3-statement",
                "name": "statement",
                "prose": "Define and document processes for responsible AI design and development."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.2",
            "title": "A.6.2.2 \u2014 Requirements and specifications",
            "parts": [
              {
                "id": "iso-42001-a.6.2.2-statement",
                "name": "statement",
                "prose": "Document requirements for new AI systems and material changes to existing systems."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.3",
            "title": "A.6.2.3 \u2014 Design and development documentation",
            "parts": [
              {
                "id": "iso-42001-a.6.2.3-statement",
                "name": "statement",
                "prose": "Document design and development in light of objectives, requirements and specification criteria."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.4",
            "title": "A.6.2.4 \u2014 Verification and validation",
            "parts": [
              {
                "id": "iso-42001-a.6.2.4-statement",
                "name": "statement",
                "prose": "Define and document verification and validation measures, including the criteria for using them."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.5",
            "title": "A.6.2.5 \u2014 Deployment planning",
            "parts": [
              {
                "id": "iso-42001-a.6.2.5-statement",
                "name": "statement",
                "prose": "Document the deployment plan and verify that applicable requirements have been met before deployment."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.6",
            "title": "A.6.2.6 \u2014 Operation and monitoring",
            "parts": [
              {
                "id": "iso-42001-a.6.2.6-statement",
                "name": "statement",
                "prose": "Define and record operational arrangements for monitoring, fixes, updates and support."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.7",
            "title": "A.6.2.7 \u2014 Technical documentation for interested parties",
            "parts": [
              {
                "id": "iso-42001-a.6.2.7-statement",
                "name": "statement",
                "prose": "Identify and provide technical information appropriate to each relevant audience."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.6.2.8",
            "title": "A.6.2.8 \u2014 Event log recording",
            "parts": [
              {
                "id": "iso-42001-a.6.2.8-statement",
                "name": "statement",
                "prose": "Choose the life-cycle stages at which event logs must be captured, including at least when the system is in use."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a7",
        "title": "A.7 \u2014 AI system data",
        "controls": [
          {
            "id": "iso-42001-a.7.2",
            "title": "A.7.2 \u2014 Development data management",
            "parts": [
              {
                "id": "iso-42001-a.7.2-statement",
                "name": "statement",
                "prose": "Define, document and implement processes for managing AI development data."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.7.3",
            "title": "A.7.3 \u2014 Data selection and acquisition",
            "parts": [
              {
                "id": "iso-42001-a.7.3-statement",
                "name": "statement",
                "prose": "Document how data used by the system was selected and obtained."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.7.4",
            "title": "A.7.4 \u2014 Data quality",
            "parts": [
              {
                "id": "iso-42001-a.7.4-statement",
                "name": "statement",
                "prose": "Document data quality requirements and ensure development and operational data meet them."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.7.5",
            "title": "A.7.5 \u2014 Data provenance tracking",
            "parts": [
              {
                "id": "iso-42001-a.7.5-statement",
                "name": "statement",
                "prose": "Document how data provenance is recorded across the lives of the AI system and its data."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.7.6",
            "title": "A.7.6 \u2014 Data preparation",
            "parts": [
              {
                "id": "iso-42001-a.7.6-statement",
                "name": "statement",
                "prose": "Document the criteria and methods used to prepare data."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a8",
        "title": "A.8 \u2014 Information for interested parties",
        "controls": [
          {
            "id": "iso-42001-a.8.2",
            "title": "A.8.2 \u2014 Information for system users",
            "parts": [
              {
                "id": "iso-42001-a.8.2-statement",
                "name": "statement",
                "prose": "Determine the information users need about the AI system and provide it."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.8.3",
            "title": "A.8.3 \u2014 External reports of adverse effects",
            "parts": [
              {
                "id": "iso-42001-a.8.3-statement",
                "name": "statement",
                "prose": "Give interested parties a way to report adverse effects of the system."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.8.4",
            "title": "A.8.4 \u2014 Incident communication",
            "parts": [
              {
                "id": "iso-42001-a.8.4-statement",
                "name": "statement",
                "prose": "Determine and document how users will be told about incidents."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.8.5",
            "title": "A.8.5 \u2014 Reporting to interested parties",
            "parts": [
              {
                "id": "iso-42001-a.8.5-statement",
                "name": "statement",
                "prose": "Identify and document obligations to provide information about the AI system to interested parties."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a9",
        "title": "A.9 \u2014 Responsible AI system use",
        "controls": [
          {
            "id": "iso-42001-a.9.2",
            "title": "A.9.2 \u2014 Processes for responsible use",
            "parts": [
              {
                "id": "iso-42001-a.9.2-statement",
                "name": "statement",
                "prose": "Define and document processes for responsible use of the AI system."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.9.3",
            "title": "A.9.3 \u2014 Responsible use objectives",
            "parts": [
              {
                "id": "iso-42001-a.9.3-statement",
                "name": "statement",
                "prose": "Identify and document objectives that guide responsible use."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.9.4",
            "title": "A.9.4 \u2014 Use within intended purposes",
            "parts": [
              {
                "id": "iso-42001-a.9.4-statement",
                "name": "statement",
                "prose": "Ensure AI system use follows its intended purposes and related documentation."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      },
      {
        "id": "a10",
        "title": "A.10 \u2014 Relationships with customers and third parties",
        "controls": [
          {
            "id": "iso-42001-a.10.2",
            "title": "A.10.2 \u2014 Allocation of responsibilities",
            "parts": [
              {
                "id": "iso-42001-a.10.2-statement",
                "name": "statement",
                "prose": "Allocate life-cycle responsibilities among the organization and relevant partners, suppliers, customers and other parties."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.10.3",
            "title": "A.10.3 \u2014 Supplier alignment",
            "parts": [
              {
                "id": "iso-42001-a.10.3-statement",
                "name": "statement",
                "prose": "Establish a process to align the use of third-party services, products and materials with responsible AI development and use."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          },
          {
            "id": "iso-42001-a.10.4",
            "title": "A.10.4 \u2014 Customer expectations",
            "parts": [
              {
                "id": "iso-42001-a.10.4-statement",
                "name": "statement",
                "prose": "Consider customer needs and expectations when taking decisions about responsible AI development and use."
              }
            ],
            "props": [
              {
                "name": "evidence-type",
                "value": "procedural"
              }
            ]
          }
        ]
      }
    ]
  }
}
